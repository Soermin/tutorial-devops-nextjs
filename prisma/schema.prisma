generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tutorial {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  content     String
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}